# ============================================================
# Frontend — Environment Variables
# Copy this file to frontend/.env and fill in your values.
# Owned by: Web Team (UI)
# ============================================================

# ----- API Base URL -----
# In development the Vite proxy handles /api → backend, so this is not needed.
# Set this for production builds where the backend runs on a different domain.
# VITE_API_BASE_URL=https://your-backend-domain.com

# ----- Feature Flags -----
# Set to "true" to show features that are still in development.
# VITE_ENABLE_BATCH_UPLOAD=false
# VITE_ENABLE_AUTH=false
